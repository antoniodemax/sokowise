# SokoWise environment variables — documented in docs/ARCHITECTURE.md §10.
# Copy to .env for local development. Never commit .env. Values here are placeholders, not secrets.

# --- Backend (Phase 1+) ---
APP_ENV=development
APP_NAME="SokoWise API"
API_HOST=0.0.0.0
API_PORT=8000
# Docker Compose derives the container URL from the POSTGRES_* values below.
DATABASE_URL=postgresql+asyncpg://sokowise:sokowise@localhost:5432/sokowise
# Hosted Postgres (Neon, Render, Railway public URL) needs TLS: append ?ssl=require (asyncpg
# spelling; not sslmode=). See docs/OPERATIONS.md §1a.
# Backend test suite (tests/db). Created automatically by docker/postgres/init on first start.
TEST_DATABASE_URL=postgresql+asyncpg://sokowise:sokowise@localhost:5432/sokowise_test
# --- Authentication (Phase 3, docs/ARCHITECTURE.md §5) ---
# HS256 signing key for access tokens, at least 32 characters. Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-at-least-32-random-characters-please
# Optional `iss`/`aud` claims; leave blank to omit them.
JWT_ISSUER=
JWT_AUDIENCE=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Browser origins exactly as sent in the Origin header: scheme://host[:port], comma-separated,
# no path and no trailing slash (a trailing slash or whitespace is tolerated and stripped).
CORS_ORIGINS=http://localhost:5173
# Regex for origins that cannot be listed exactly (Vercel preview deployments), e.g.
#   ^https://sokowise-[a-z0-9-]+\.vercel\.app$   — only on the preview API environment.
CORS_ORIGIN_REGEX=
# Refresh-token cookie. Production must use COOKIE_SECURE=true (the app refuses to start
# otherwise). COOKIE_SAMESITE=lax when app and API share a registrable domain; `none`
# (requires Secure) only on the preview API environment, where the app is cross-site.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOG_LEVEL=INFO
# Sentry error reporting (docs/OPERATIONS.md). Empty = disabled. No PII, no request bodies.
SENTRY_DSN=
# Behind a platform proxy (Railway) set FORWARDED_ALLOW_IPS=* in the service environment so
# uvicorn reads the client address from X-Forwarded-For (per-IP rate limits, audit ip).
# Never set it where the port is published directly (docker-compose).
# FORWARDED_ALLOW_IPS=*
# Connection pool per process and the server-side statement timeout (ms).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=30000
# Per-process limits (ARCHITECTURE §5.2): login is per IP and per identifier, register and
# refresh per IP, password change per user.
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_PASSWORD_CHANGE_PER_MINUTE=5

# --- Docker Compose (local development only) ---
POSTGRES_USER=sokowise
POSTGRES_PASSWORD=sokowise
POSTGRES_DB=sokowise
POSTGRES_PORT=5432

# --- AI (Phase 9+) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Per-business quotas are operator-controlled; they are not editable through the API.
AI_DAILY_MESSAGE_LIMIT=10
AI_MONTHLY_MESSAGE_LIMIT=100
AI_MONTHLY_BUDGET_USD=
# Copilot request shaping (all optional; defaults shown). ANTHROPIC_API_KEY unset → the copilot
# answers 503 AI_NOT_CONFIGURED and the rest of the app keeps working.
AI_MAX_OUTPUT_TOKENS=2000
AI_THINKING=adaptive
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_TOOL_ROUNDS=6
AI_HISTORY_MESSAGES=20
RATE_LIMIT_AI_MESSAGES_PER_MINUTE=10
# Supplier receipt images: local blob directory and upload limits. The relative default is
# development-only; production must use an absolute path on persistent storage (a mounted
# volume, e.g. /data/receipts) and refuses to start otherwise (docs/OPERATIONS.md).
RECEIPT_STORAGE_DIR=var/receipts
RECEIPT_MAX_BYTES=8388608
RECEIPT_MAX_PIXELS=25000000
RECEIPT_MIN_SIDE_PX=200

# --- Frontend ---
# Leave empty in local development: the Vite dev server proxies /api to the backend so the
# refresh cookie stays same-origin. Production/preview: the API origin, e.g. https://api.sokowise.example
# Public origin of the web app (no trailing slash), used for canonical and Open Graph URLs on the public site. Leave empty until the domain is final.
VITE_PUBLIC_URL=
VITE_API_BASE_URL=
VITE_SENTRY_DSN=

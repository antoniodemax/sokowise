# SokoWise environment variables — documented in docs/ARCHITECTURE.md §10.
# Copy to .env for local development. Never commit .env. Values here are placeholders, not secrets.

# --- Backend (Phase 1+) ---
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://sokowise:sokowise@localhost:5432/sokowise
JWT_SECRET=change-me-to-at-least-32-random-bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false
LOG_LEVEL=INFO
RATE_LIMIT_LOGIN_PER_MINUTE=5
SENTRY_DSN=

# --- AI (Phase 9+) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_DAILY_MESSAGE_LIMIT_DEFAULT=50
AI_MONTHLY_BUDGET_USD=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SENTRY_DSN=
